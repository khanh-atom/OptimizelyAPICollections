{
  "request": {
    "method": "PATCH",
    "name": "Patch content version properties",
    "url": {
      "raw": "{{API_URL}}/v1/content/{{ContentID}}/versions/{{VersionNumber}}",
      "query": []
    },
    "header": [
      {
        "id": "40d31eda-ac92-400d-a91b-ce3359c8660c",
        "key": "Authorization",
        "value": "Bearer {{AccessToken}}",
        "disabled": false,
        "type": "text"
      },
      {
        "id": "c4acf361-7c70-44bb-a4c0-0cf881c0d70d",
        "key": "Content-Type",
        "value": "application/merge-patch+json",
        "disabled": false,
        "type": "text"
      },
      {
        "id": "960acd36-11d6-4775-abe6-00398047c2a6",
        "key": "Accept",
        "value": "application/json",
        "disabled": false,
        "type": "text"
      }
    ],
    "body": {
      "mode": "raw",
      "raw": "{\r\n  \"properties\": { \r\n    \"Title\": {\r\n        \"value\": \"test-patch\"\r\n      }\r\n  }\r\n}",
      "options": {
        "raw": {
          "language": "json"
        }
      }
    }
  },
  "readme": "To open this file inside VSCode, you need to install Thor Client extension https://thorclient.com/",
  "event": {
    "assert": [
      {
        "key": "response.status",
        "value": "200",
        "disabled": false,
        "type": "text",
        "operator": "=="
      }
    ]
  },
  "response": {
    "keys": [
      "type",
      "title",
      "status",
      "detail",
      "instance",
      "traceId"
    ]
  }
}